MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
CLOUD_PROVIDER=aws
AWS_DEFAULT_REGION=us-east-1
# Uncomment after creating your real bucket; local API otherwise uses models/model.joblib.
# ARTIFACT_BUCKET=your-real-bucket-name
# For DagsHub tracking, replace MLFLOW_TRACKING_URI and set these locally or in GitHub Secrets:
# MLFLOW_TRACKING_USERNAME=your-dagshub-username
# MLFLOW_TRACKING_PASSWORD=your-dagshub-token
